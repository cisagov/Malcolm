# Whether or not Zeek should monitor live traffic on a local
#   interface (PCAP_IFACE variable below specifies capture interfaces)
ZEEK_LIVE_CAPTURE=false
# Set ZEEK_DISABLE_STATS to false or blank to generate stats.log and capture_loss.log
ZEEK_DISABLE_STATS=true
# Set ZEEK_DISABLE_INTEL_LIVE to true to disable @load-ing zeek/intel for live capture
ZEEK_DISABLE_INTEL_LIVE=false
# Set to true to enable Zeek's ZAM script optimizer (-O ZAM)
#   https://docs.zeek.org/en/master/advanced/scripting/optimization.html
# WARNING: ZAM compiles all loaded scripts every time Zeek starts, which can
#   make startup take much longer. Live capture starts once and runs for a
#   long time, so it can make up that cost. Offline processing starts Zeek
#   for every PCAP and pays it each time. If you enable ZAM, enable it for
#   live capture only.
ZEEK_ZAM_ENABLED=false

ZEEK_PCAP_PROCESSOR=false
ZEEK_LOG_PATH=/zeek/live
EXTRACT_FILES_PATH=/zeek/extract_files
