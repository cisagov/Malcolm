# For an external server, set POSTGRES_DISABLED=true and provision both
# application databases and roles first. See docs/external-postgresql.md.
POSTGRES_HOST=postgres
PGPORT=5432
# libpq clients (NetBox, readiness checks and backup/restore).
# Use verify-full and a trusted PGSSLROOTCERT for an external server.
PGSSLMODE=prefer
# PGSSLROOTCERT=/var/local/ca-trust/postgres-ca.crt

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=xxxxxxxxxxxxxxxx

POSTGRES_NETBOX_DB=netbox
POSTGRES_NETBOX_USER=netbox
POSTGRES_NETBOX_PASSWORD=xxxxxxxxxxxxxxxx

POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_KEYCLOAK_USER=keycloak
POSTGRES_KEYCLOAK_PASSWORD=xxxxxxxxxxxxxxxx

POSTGRES_DISABLED=false
K8S_SECRET=True