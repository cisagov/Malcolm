#!/bin/bash

# Copyright (c) 2026 Battelle Energy Alliance, LLC.  All rights reserved.

set -e

# harbian-audit is pinned to a commit (git verifies the checkout, and submodules are pinned by it)
HARBIAN_AUDIT_COMMIT="19115b7acb66fd7eee4682e187702f63bee6b424"

# fetch harbian-audit at that commit and clean up some stuff we don't need
mkdir -p /opt/harbianaudit
cd /opt/harbianaudit
git init -q
git remote add origin https://github.com/hardenedlinux/harbian-audit
git fetch -q --depth 1 origin "$HARBIAN_AUDIT_COMMIT"
git checkout -q FETCH_HEAD
git submodule update -q --init --recursive --depth 1
cd /
sed -i "s#CIS_ROOT_DIR=.*#CIS_ROOT_DIR='/opt/harbianaudit'#" /opt/harbianaudit/etc/default.cfg
cp /opt/harbianaudit/etc/default.cfg /etc/default/cis-hardening
rm -rf /opt/harbianaudit/.git