# AKS storage example for Malcolm.
#
# Azure Files CSI provides ReadWriteMany volumes for data shared across pods.
# Azure Disk CSI provides ReadWriteOnce volumes for OpenSearch data.
# Adjust requested capacities to match retention and workload requirements.

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: pcap-claim
  namespace: malcolm
spec:
  storageClassName: azurefile-csi-premium
  accessModes:
    - ReadWriteMany
  volumeMode: Filesystem
  resources:
    requests:
      storage: 500Gi

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: zeek-claim
  namespace: malcolm
spec:
  storageClassName: azurefile-csi-premium
  accessModes:
    - ReadWriteMany
  volumeMode: Filesystem
  resources:
    requests:
      storage: 250Gi

